{
  "team": "devops-dev",
  "teamDisplayName": "DevOps L1",
  "aws": {
    "region": "us-east-1",
    "amiId": "ami-075d73f700ef0e7b3",
    "instanceType": "t3.micro"
  },
  "passwordSafe": {
    "workgroupName": "WG-DevOps-L1",
    "smartRuleSystems": "SR-L1-Systems",
    "smartRuleAccounts": "SR-L1-Accounts",
    "consumerGroup": "GRP-DevOps-L1",
    "platformName": "Linux",
    "port": 22,
    "timeout": 30,
    "elevationCommand": "sudo",
    "releaseDuration": 120,
    "maxReleaseDuration": 525600,
    "isaReleaseDuration": 120,
    "maxConcurrentRequests": 1,
    "changeFrequencyType": "first",
    "changeTime": "23:30",
    "checkPassword": false,
    "resetOnMismatch": false,
    "changePasswordAfterRelease": true,
    "passwordRuleId": 0,
    
    "accounts": [
      {
        "accountType": "managed",
        "localAccountName": "ec2-svc",
        "authType": "ssh_key",
        "enableSSHKeyAuth": true,
        "sshKeyEnforcementMode": 0
      },
      {
        "accountType": "managed",
        "localAccountName": "ec2-user-dev",
        "authType": "password",
        "passwordVaultPath": "ps-ephemeral/dev/ec2-user-dev",
        "enableSSHKeyAuth": false
      }
    ],
    
    "functionalAccount": {
      "functionalAccountName": "ps-rotator",
      "authType": "ssh_key",
      "enableSSHKeyAuth": true
    }
  },
  "tags": {
    "Owner": "DevOpsL1",
    "Lifecycle": "ephemeral",
    "ManagedBy": "ps-ephemeral-ec2"
  }
}
